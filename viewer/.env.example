# Public base URL where GLB files are readable (R2 public bucket URL or custom domain).
# No trailing slash. Used at build time for the viewer.
VITE_R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev

# Set these in Vercel Project → Settings → Environment Variables (not in .env for production).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev
